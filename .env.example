# Copy to .env (git-ignored) and fill in. Vite exposes only VITE_* vars to the browser.

# ArcGIS Online OAuth app (public client ID, PKCE; no client secret needed)
VITE_ARCGIS_CLIENT_ID=
VITE_ARCGIS_PORTAL_URL=https://www.arcgis.com
VITE_ARCGIS_REDIRECT_URI=http://localhost:5173/

# Orgs this build may write to (send email through the hidden group), as a comma list of org ids (portals/self.id).
# Empty means read-only everywhere: no groups, no notifications, nothing created. Vite reads it at dev-server start,
# so restart `npm run dev` after changing it.
VITE_WRITABLE_ORG_IDS=

# Emails step: sending real digests to owners. Off unless exactly "true". With it off, "Send a test to me"
# (to the signed-in admin only) still works in a writable org, and the send button shows
# "Sending to owners is switched off in this build". The demo uses an in-memory fake and is not affected.
VITE_ALLOW_OWNER_SENDS=

# About page: the source repository link. Optional; it defaults to https://github.com/simongis/decluttering-web.
# Set a full https address if you host your own fork.
VITE_REPO_URL=

# Optional: a Cloudflare Web Analytics token (cookie-free page-view counts). The beacon is added only when set.
VITE_CF_BEACON_TOKEN=

# Sign-in note: the redirect URI above must be registered on the OAuth app exactly (Vite dev must use port 5173).
# Register your own OAuth app with your own redirect URI if you host this yourself.
